{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "auth:generate": "pnpm dlx auth@latest generate --config src/generate.ts --adapter drizzle --dialect postgresql --output ../db/src/auth-schema.ts --yes",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "better-auth": "1.7.21",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.7",
    "@better-auth/oauth-provider": "1.7.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./client": {
      "default": "./src/client.ts"
    },
    "./oauth": {
      "default": "./src/oauth-provider.ts"
    }
  }
}
