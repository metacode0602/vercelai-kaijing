{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:seed:metal": "tsx src/scripts/seed-metal-devices.ts",
    "db:seed:admin": "tsx src/scripts/platform-admin-init.ts",
    "db:seed:funding": "tsx src/scripts/seed-merchant-funding.ts",
    "db:seed:images": "tsx src/scripts/seed-base-images.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:seed:commerce-products": "tsx src/scripts/seed-commerce-products.ts",
    "db:seed:commerce-purchase": "tsx src/scripts/seed-commerce-purchase.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/pg": "^8.20.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema.ts"
    },
    "./merchant-purchase-price-sync": {
      "default": "./src/merchant-purchase-price-sync.ts"
    }
  }
}
