{
  "name": "studio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "turbo start",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "docker:build:web": "docker build -f docker/Dockerfile --target web --build-arg BUILD_TARGET=web -t gongji-crm-web:latest .",
    "docker:build:docs": "docker build -f docker/Dockerfile --target docs --build-arg BUILD_TARGET=docs -t gongji-crm-docs:latest .",
    "docker:build:api": "docker build -f docker/Dockerfile --target api --build-arg BUILD_TARGET=api -t gongji-crm-api:latest .",
    "docker:build:gpus": "docker build -f apps/gpus/Dockerfile -t gongji-crm-gpus:latest .",
    "docker:compose:build": "docker compose -f docker/docker-compose.build.yml build",
    "docker:build": "docker compose -f docker/docker-compose.build.yml build"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.21.0",
    "turbo": "^2.9.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "next": "16.3.6"
    },
    "patchedDependencies": {
      "next-themes@0.4.6": "patches/next-themes@0.4.6.patch",
      "drizzle-orm@0.45.3": "patches/drizzle-orm@0.45.3.patch"
    }
  }
}
