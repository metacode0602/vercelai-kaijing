{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "CONSUMER_SITE_URL",
    "CRON_SECRET",
    "DARAZ_APP_KEY",
    "DARAZ_APP_SECRET",
    "DARAZ_CALLBACK_URL",
    "DARAZ_DEFAULT_REGION",
    "DATABASE_URL",
    "LAZADA_APP_KEY",
    "LAZADA_APP_SECRET",
    "LAZADA_CALLBACK_URL",
    "LAZADA_DEFAULT_REGION",
    "LIBLIB_API_KEY",
    "LIBLIB_API_SECRET",
    "LIBLIB_OPENAPI_BASE_URL",
    "MARKETPLACE_CREDENTIALS_KEY",
    "MARKETPLACE_SYNC_CRON_ENABLED",
    "MARKETPLACE_SYNC_CRON_TIMEZONE",
    "MARKETPLACE_SYNC_ORDERS_CRON",
    "MARKETPLACE_SYNC_LOGISTICS_CRON",
    "MARKETPLACE_SYNC_REVIEWS_CRON",
    "MARKETPLACE_SYNC_ORDERS_BACKFILL_DAYS",
    "MARKETPLACE_SYNC_ORDERS_OVERLAP_MINUTES",
    "MARKETPLACE_SYNC_ORDERS_MAX_PAGES",
    "MARKETPLACE_SYNC_LOGISTICS_LIMIT",
    "MARKETPLACE_SYNC_LOGISTICS_LOOKBACK_DAYS",
    "MARKETPLACE_SYNC_REVIEWS_ITEMS_LIMIT",
    "MARKETPLACE_SYNC_REVIEWS_LOOKBACK_DAYS",
    "MARKETPLACE_SYNC_REVIEWS_MAX_PAGES",
    "MARKETPLACE_TOKEN_REFRESH_SKEW_SECONDS",
    "MARKETPLACE_WEBHOOK_SKIP_VERIFY",
    "MARKETPLACE_WEBHOOK_SYNC_ENABLED",
    "MERCHANT_AUTO_RECHARGE_ENABLED",
    "MERCHANT_VOUCHER_EXPIRY_BATCH_SIZE",
    "MERCHANT_VOUCHER_EXPIRY_CRON",
    "MERCHANT_VOUCHER_EXPIRY_ENABLED",
    "MERCHANT_VOUCHER_EXPIRY_MAX_BATCHES",
    "MERCHANT_VOUCHER_EXPIRY_TIMEZONE",
    "MISTRAL_API_KEY",
    "NEXT_PUBLIC_URL",
    "NODE_ENV",
    "PORT",
    "REDIS_DB",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_URL",
    "SHOP_BINDING_REQUIRES_APPROVAL",
    "SHOP_DEV_ORGANIZATION_ID",
    "SKYPILOT_API_TOKEN",
    "SKYPILOT_API_URL",
    "STORAGE_LOCAL_DIR",
    "TIKTOK_APP_KEY",
    "TIKTOK_APP_SECRET",
    "TIKTOK_CALLBACK_URL",
    "TIKTOK_DEFAULT_REGION",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "WAVERLESS_BASE_URL",
    "WAVERLESS_CONTROL_API_URL",
    "WAVERLESS_GONGJI_COST_PER_GPU_HOUR",
    "WAVERLESS_SERVICE_API_KEY",
    "WAVERLESS_SERVICE_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
