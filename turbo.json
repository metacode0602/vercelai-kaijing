{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "BETTER_AUTH_URL",
    "CONSUMER_SITE_URL",
    "CRON_SECRET",
    "DATABASE_URL",
    "LIBLIB_API_KEY",
    "LIBLIB_API_SECRET",
    "LIBLIB_OPENAPI_BASE_URL",
    "MERCHANT_AUTO_RECHARGE_ENABLED",
    "MERCHANT_VOUCHER_EXPIRY_BATCH_SIZE",
    "MERCHANT_VOUCHER_EXPIRY_CRON",
    "MERCHANT_VOUCHER_EXPIRY_ENABLED",
    "MERCHANT_VOUCHER_EXPIRY_MAX_BATCHES",
    "MERCHANT_VOUCHER_EXPIRY_TIMEZONE",
    "MISTRAL_API_KEY",
    "PORT",
    "REDIS_DB",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_URL",
    "SKYPILOT_API_TOKEN",
    "SKYPILOT_API_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "WAVERLESS_BASE_URL",
    "WAVERLESS_CONTROL_API_URL",
    "WAVERLESS_SERVICE_API_KEY",
    "WAVERLESS_SERVICE_SECRET",
    "WAVERLESS_GONGJI_COST_PER_GPU_HOUR"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
