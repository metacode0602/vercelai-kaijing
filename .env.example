DATABASE_URL=postgres://postgres:password@localhost:5432/studio

# 数据库 TLS 策略（默认自动：localhost 关闭，其余云端连接开启且不校验证书链，兼容 Supabase/池化代理）
# DATABASE_SSL=require     # 严格校验证书
# DATABASE_SSL=noverify    # 开启 TLS 但不校验证书（云端默认）
# DATABASE_SSL=disable     # 完全关闭 TLS
DATABASE_SSL=auto
# 连接池上限（Vercel serverless + Supabase 事务池建议按池上限调小，如 1）
# DATABASE_POOL_MAX=10

# Redis（@workspace/redis）：配置 UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN 时走 Upstash（Vercel 云端），否则回落本地 Redis
# Upstash Redis（云端，与本地配置二选一）
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
# 本地 Redis（默认 localhost:6379 db 0）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# 本地 Redis 连接 URL（支持 redis:// 与 rediss://，优先于上面 host/port/password/db）：
# REDIS_URL=rediss://user:pass@redis.example.com:6380/0

# 腾讯云短信（@workspace/redis/sms）：web / gpus / merchant / supplier 验证码与身份短信通用配置
# 发送双重限流（冷却 + 每日上限）基于 Redis，无需额外配置
# 生产环境（NODE_ENV=production）真实发送；开发环境默认模拟（验证码仅写日志，不产生真实短信）
# 如需在开发环境强制真实发送，设置 SMS_FORCE_REAL_SEND=1
# 主配置（启用真实发送时请填写以下 COS_* 变量）：
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_SMS_APPID=
# COS_SMS_TEMPLATEID=
# COS_SMS_SIGN_NAME=
# 验证码有效期（分钟），作为短信模板第二个参数，默认 5
# COS_SMS_SIGN_MINUTE=5
# 兼容旧变量名（优先读 COS_*）：
# SMS_TENCENT_SECRET_ID=
# SMS_TENCENT_SECRET_KEY=
# SMS_SDK_APP_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_ID=
# 默认 ap-nanjing，按需覆盖
# SMS_REGION=ap-nanjing
# SMS_FORCE_REAL_SEND=1

# 邮件 SMTP（@workspace/email，nodemailer）：web / gpus / merchant / supplier 验证邮件与找回密码
SMTP_HOST=smtp.qiye.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=service@openroute.cn
SMTP_PASS=
SMTP_FROM=service@openroute.cn
# SMTP 超时（毫秒）。不配置时 nodemailer 在主机不可达时会持续重试，导致发信类接口（如找回密码）无限挂起。
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000

BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# apps/api —— 平台内部服务间同步凭证（/api/v1/sync/*）。
# 未配置时该端点一律 401：宁可不可用，也不能裸奔。至少 16 位。
INTERNAL_SYNC_API_KEY=your-internal-sync-api-key-here

# 算算力 OpenAPI（Admin API，仅服务端；Cookie + token 头 + RSA 签名）
SUANLI_OPENAPI_BASE_URL=https://openapi.suanli.cn
SUANLI_OPENAPI_COOKIE=
SUANLI_OPENAPI_TOKEN=
SUANLI_OPENAPI_RSA_PRIVATE_KEY=
# SUANLI_OPENAPI_RSA_PUBLIC_KEY=

# 算算力 Supply OpenAPI（供应商入驻同步，凭证独立）
SUANLI_SUPPLY_OPENAPI_BASE_URL=https://openapi.suanli.cn
SUANLI_SUPPLY_OPENAPI_COOKIE=
SUANLI_SUPPLY_OPENAPI_TOKEN=
SUANLI_SUPPLY_OPENAPI_RSA_PRIVATE_KEY=
# SUANLI_SUPPLY_OPENAPI_RSA_PUBLIC_KEY=

# 账单定时同步：跳过租户自动导入的平台商户 ID（逗号分隔，默认始终跳过共绩 0）
# MERCHANT_TENANT_IMPORT_EXCLUDED_PLATFORM_MERCHANT_IDS=123,456

# 本地文件存储根目录（各模块在其下使用独立子目录，如 finance-imports、project-activity-attachments）
DATA_DIR=.data

# 发票附件上传目录（运营开票时上传的 PDF/图片文件存储路径）
# 默认为 /tmp/invoice-attachments，生产环境建议配置到持久化存储或使用对象存储
INVOICE_UPLOAD_DIR=/tmp/invoice-attachments

# 统一对象存储（@workspace/storage）：web / gpus / supplier 所有文件上传默认走阿里云 OSS
# 驱动：STORAGE_DRIVER=local | oss（默认 oss；OSS 未配置时自动回退 local）
STORAGE_DRIVER=oss
# 阿里云 OSS（主要配置）：
STORAGE_REGION=cn-hangzhou
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=zenly
STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
STORAGE_PUBLIC_URL=https://zenly.oss-cn-hangzhou.aliyuncs.com
# 内网访问（提升性能；需 OSS 内网 endpoint 服务）
STORAGE_OSS_INTERNAL=false
# 使用 HTTPS（默认 true）
STORAGE_OSS_SECURE=true
# 兼容旧变量名（优先读 STORAGE_*）：
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=
# OSS_PUBLIC_BASE_URL=
# 历史按模块驱动的旧开关（local=本地目录，与 STORAGE_DRIVER 等价）：
# PROJECT_ACTIVITY_STORAGE_DRIVER=local
# SUPPLIER_ACTIVITY_STORAGE_DRIVER=local

# 员工登录账号（管理员创建员工时的默认密码，须符合密码复杂度策略）
STAFF_DEFAULT_PASSWORD=ChangeMe123!
# 历史用户 provisioned_by 回填时使用的管理员 users.id（见设计文档 §9.2）
# BOOTSTRAP_ADMIN_USER_ID=

# 飞书集成
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 可选：多维表格开启高级权限时，tenant token 可能被拒；配置有表格权限的用户 token 作为 API 回退
# FEISHU_USER_ACCESS_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_WEBHOOK_SECRET=
# FEISHU_AUTOMATION_SECRET=
# FEISHU_AUTOMATION_TOKEN=
# FEISHU_DEFAULT_USER_OPEN_ID=
# FEISHU_APPROVAL_FORM_FIELD_ID=
# FEISHU_APPROVAL_CODES={"online":"xxx","order_access":"xxx","device_retire":"xxx","internal_occupancy":"xxx"}
# FEISHU_AUTO_CREATE_ENABLED=true
# FEISHU_AUTO_COMPLETE_ON_APPROVAL=true
# APP_BASE_URL=http://localhost:3000

# 面向终端用户的注册站域名（apps/gpus）。商户推广链接指向这里：
# 只有 apps/gpus 的注册流程会读取 ?r= 推广码并写 merchant_promo_attribution，
# 商户控制台域名（apps/merchant）的注册页不处理推广码，指向它会丢失归因。
# 留空时回落到 http://localhost:3000。
# CONSUMER_SITE_URL=https://gpurun.com

# ---------------------------------------------------------------------------
# 商户预付充值：线上支付渠道（@workspace/billing，apps/merchant 消费）
# 凭据**任一项缺失即该渠道关闭**（前端不显示入口，建单直接拒绝），不会产生
# 「进得去、付不了」的脏单。对公转账不依赖这些变量，恒可用。
#
# 微信支付 V3（Native 扫码：下单 /v3/pay/transactions/native，返回 code_url 渲染二维码）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_PRIVATE_KEY=      # 商户 API 私钥（PKCS8 PEM，换行写成 \n）
# WECHAT_PAY_SERIAL_NO=        # 商户证书序列号
# WECHAT_PAY_PLATFORM_CERT=    # 微信支付平台证书公钥（用于验签响应与回调）
# WECHAT_PAY_PLATFORM_SERIAL_NO=
# WECHAT_PAY_API_V3_KEY=       # APIv3 密钥（32 字节，用于解密 resource）
# WECHAT_PAY_NOTIFY_URL=https://your-domain/api/payments/notify/wechat
#
# 支付宝开放平台（网页支付 alipay.trade.page.pay：返回签名跳转 URL）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=           # 支付宝公钥（不是自己的公钥），用于验签通知与查单响应
# ALIPAY_NOTIFY_URL=https://your-domain/api/payments/notify/alipay
# ALIPAY_RETURN_URL=https://your-domain/console/account   # 付款后浏览器跳回，仅用于展示，不作为到账凭据
# 沙箱网关（留空走生产 openapi.alipay.com）
# ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# ---------------------------------------------------------------------------
# 供应商结算出账（apps/web cron，见 apps/web/src/lib/server/jobs/register-supplier-billing-cron.ts）
# 出账逻辑在 apps/web；apps/supplier 只做只读展示与确认/申请流程。
# ---------------------------------------------------------------------------
# 总开关：非 'true' 时日账单与月账单 cron 均不注册
# SUPPLIER_BILLING_ENABLED=true
# 日账单 cron（默认 5 0 * * * = 每日 00:05，Asia/Shanghai）
# SUPPLIER_BILLING_DAILY_CRON=5 0 * * *
# 月账单 cron（默认 0 2 2 * * = 每月 2 日 02:00，Asia/Shanghai）
# 设计要求月结在次月 2 日出账：日账单已出完，且留出 1 日人工核账窗口
# SUPPLIER_BILLING_MONTHLY_CRON=0 2 2 * *
# 出账所用时区（日/月边界按此时区切分）
# SUPPLIER_BILLING_TIMEZONE=Asia/Shanghai
# 内部 cron 接口鉴权密钥（/api/internal/cron/* 必填，未配置时接口一律拒绝）
# CRON_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# 商户门户（apps/merchant）跨站链接：营销页 CTA 指向独立部署的文档站与最终用户控制台
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_DOCS_URL=https://docs.gpurun.ai     # 文档站源站（应用内会拼接 /docs）
# NEXT_PUBLIC_PLATFORM_URL=https://www.gpurun.cn   # 最终用户控制台（apps/gpus）
# 自动充值扫描总开关（默认开启；置为 false 时 cron 直接返回 skipped）
# MERCHANT_AUTO_RECHARGE_ENABLED=true

# ---------------------------------------------------------------------------
# 商户算力券过期回收（apps/web cron，见 apps/web/src/lib/server/jobs/register-voucher-expiry-cron.ts）
# 过期券的剩余额度必须退回商户券池（reserved → available），否则商户的钱
# 会被一张没人用的券永久锁死。这是资金正确性兜底，默认开启。
# ---------------------------------------------------------------------------
# 总开关：显式置为 false 才停用（未设置 = 开启）
# MERCHANT_VOUCHER_EXPIRY_ENABLED=true
# 回收 cron（默认 17 * * * * = 每小时第 17 分，Asia/Shanghai）
# MERCHANT_VOUCHER_EXPIRY_CRON=17 * * * *
# 调度时区
# MERCHANT_VOUCHER_EXPIRY_TIMEZONE=Asia/Shanghai
# 单批扫描张数 / 单次运行最多批数（防止积压时一次扫空库）
# MERCHANT_VOUCHER_EXPIRY_BATCH_SIZE=200
# MERCHANT_VOUCHER_EXPIRY_MAX_BATCHES=10

# ---------------------------------------------------------------------------
# Waverless control plane (apps/gpus serverless Gongji/CN path)
# Platform service credentials only — NEVER give tenants the global key.
# Gongji vendor credentials stay inside waverless (platform-managed for P0).
# ---------------------------------------------------------------------------
# WAVERLESS_BASE_URL=https://waverless.internal.example
# Alias accepted by client: WAVERLESS_CONTROL_API_URL
# WAVERLESS_SERVICE_API_KEY=platform-service-bearer-token
# Alias accepted: WAVERLESS_SERVICE_SECRET

# Gongji provisional supplier cost rate (CNY per GPU-hour). Distinct from customer sell price.
# If unset, cost quantity is still accrued with amount 0 and metadata rate_missing.
# WAVERLESS_GONGJI_COST_PER_GPU_HOUR=2.50

# Serverless deploy UI + create path product params (JSON). See apps/gpus/config/serverless-deploy.example.json
# SERVERLESS_DEPLOY_CONFIG='{"placementMode":"auto","defaultOrchestratorType":"waverless","defaults":{...},"gpuCountOptions":[1,2,4,8],"logicalRegions":[],"skypilotRegions":[],"waverlessLogicalAzs":[],"gongjiProviderSkuByGpuId":{"rtx-4090":"..."}}'

# Optional overrides (merge/replace sections of SERVERLESS_DEPLOY_CONFIG):
# WAVERLESS_LOGICAL_AZ_JSON=[{"logicalAzId":"cn-hebei-az1",...}]
# WAVERLESS_GONGJI_PROVIDER_SKU_MAP={"rtx-4090":"gongji-vendor-mark"}
# WAVERLESS_GONGJI_PROVIDER_SKU_RTX_4090=per-gpu-env-override

# ---------------------------------------------------------------------------
# Marketplace connectors (Daraz / Lazada / TikTok Shop) — apps/shop OAuth + sync
#
# CHECKLIST (local OAuth smoke):
# 1. Create apps in open.daraz.com / open.lazada.com / TikTok Partner Center.
# 2. Set Redirect / Callback URL to EXACTLY the same value as *_CALLBACK_URL below
#    (or the default {BETTER_AUTH_URL}/api/marketplace/oauth/callback).
# 3. Paste App Key + App Secret into the vars for each platform you use.
# 4. Set MARKETPLACE_CREDENTIALS_KEY (64 hex chars recommended) before connecting.
# 5. Seed shops with packages/db/seeds/commerce-daraz-lk-shop.sql so shop.id matches
#    console mocks (Daraz LK cuid b5ofcwj2mzauov29y08m0q99) — OAuth authorize needs
#    a real shops.id row.
# 6. Open /console/settings/shops/{shopId} → Connect / 重连 OAuth.
# 7. Optional sync dry-run: pnpm --filter shop sync:marketplace -- --shopId=… --platform=daraz
#
# Default region emphasis: Daraz LK (lk). Callback must match the partner console.
# ---------------------------------------------------------------------------

# --- Daraz (LAZOP) — default region lk ---
# DARAZ_APP_KEY=your_daraz_app_key
# DARAZ_APP_SECRET=your_daraz_app_secret
# Must match open.daraz.com app callback, e.g. https://localhost:3000/api/marketplace/oauth/callback
# DARAZ_CALLBACK_URL=http://localhost:3000/api/marketplace/oauth/callback
# DARAZ_DEFAULT_REGION=lk
# Optional live sync token (after OAuth); prefer DB-encrypted credentials in prod
# DARAZ_ACCESS_TOKEN=

# --- Lazada (LAZOP) ---
# LAZADA_APP_KEY=your_lazada_app_key
# LAZADA_APP_SECRET=your_lazada_app_secret
# Must match open.lazada.com app callback
# LAZADA_CALLBACK_URL=http://localhost:3000/api/marketplace/oauth/callback
# LAZADA_DEFAULT_REGION=sg
# LAZADA_ACCESS_TOKEN=

# --- TikTok Shop (Partner Center) ---
# TIKTOK_APP_KEY=your_tiktok_app_key
# TIKTOK_APP_SECRET=your_tiktok_app_secret
# Must match TikTok Partner Center redirect URL
# TIKTOK_CALLBACK_URL=http://localhost:3000/api/marketplace/oauth/callback
# TIKTOK_DEFAULT_REGION=global
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_SHOP_CIPHER=

# AES-256-GCM key for integration_credentials.payload_encrypted
# Prefer 64 hex chars (32 bytes). Any utf8 string is SHA-256 hashed to 32 bytes.
# Falls back to BETTER_AUTH_SECRET when unset (dev only).
# MARKETPLACE_CREDENTIALS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Sync worker CLI (apps/shop src/workers/marketplace-sync.ts) ---
# MARKETPLACE_SYNC_SHOP_ID=b5ofcwj2mzauov29y08m0q99
# MARKETPLACE_SYNC_PLATFORM=daraz
# MARKETPLACE_SYNC_REGION=lk
# MARKETPLACE_SYNC_LIVE=0
# MARKETPLACE_SYNC_PERSIST=0
# MARKETPLACE_SYNC_ACCESS_TOKEN=
# MARKETPLACE_SYNC_REFRESH_TOKEN=
