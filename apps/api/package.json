{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=./.env src/index.ts",
    "test": "tsx --test --test-concurrency=1 src/lib/*.test.ts",
    "build": "tsdown",
    "start": "node --env-file=./.env dist/index.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^1.2.4",
    "@hono/zod-validator": "^0.7.6",
    "@scalar/hono-api-reference": "^0.10.5",
    "@t3-oss/env-core": "^0.13.11",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.5",
    "nanoid": "^5.1.7",
    "pg": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/pg": "^8.20.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
